[Unit]
Description=PAROL6 Touchscreen Kiosk Display Interface
After=network.target parol6-daemon.service
Wants=parol6-daemon.service

[Service]
Type=simple
User=mark
Group=mark
SupplementaryGroups=video input tty render dialout
PAMName=login
TTYPath=/dev/tty7
StandardInput=tty
StandardOutput=journal
StandardError=journal
Environment=HOME=/home/mark
Environment=USER=mark
ExecStart=/usr/local/bin/launch-parol6-kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
