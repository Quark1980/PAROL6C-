[Unit]
Description=PAROL6 6-DOF Robot Trajectory & Kinematics Control Daemon
After=network.target
Wants=network.target

[Service]
Type=simple
# Generated dynamically during deployment to match active user
User=mark
Group=mark
WorkingDirectory=/home/mark/parol6
ExecStart=/usr/bin/python3 /home/mark/parol6/daemon/robot_daemon.py
Restart=always
RestartSec=3
StandardOutput=journal
StandardError=journal
LimitRTPRIO=99
LimitMEMLOCK=infinity
CPUSchedulingPolicy=fifo
CPUSchedulingPriority=80

[Install]
WantedBy=multi-user.target
