<Window x:Class="PAROLC_ControlSuite.Views.DebugStreamWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PAROL6 Real-Time Data Stream &amp; Hardware I/O Monitor"
        Height="820" Width="1100"
        MinHeight="550" MinWidth="850"
        Background="#0B0F19"
        Foreground="#E2E8F0"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#334155"/>
                    <Setter Property="BorderBrush" Value="#00E5FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0F172A"/>
            <Setter Property="Foreground" Value="#00E5FF"/>
            <Setter Property="BorderBrush" Value="#334155"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#94A3B8"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header & Telemetry Metrics Strip -->
            <RowDefinition Height="Auto"/>
            <!-- Filter & Controls Toolbar -->
            <RowDefinition Height="Auto"/>
            <!-- Live Packet Stream List -->
            <RowDefinition Height="*"/>
            <!-- Status & Hardware Slots Footer -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header & Live Telemetry Strip -->
        <Border Grid.Row="0" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#00E5FF" Width="10" Height="10" CornerRadius="5" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="LIVE DATA STREAM &amp; HARDWARE I/O MONITOR" FontWeight="Bold" FontSize="14" Foreground="#00E5FF" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtConnStatus" Text="[CONNECTED]" FontSize="11" FontWeight="Bold" Foreground="#10B981" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Real-Time Metrics Counters -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock x:Name="TxtRxCount" Text="RX: 0 pkts" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock x:Name="TxtTxCount" Text="TX: 0 pkts" FontSize="11" Foreground="#C084FC" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock x:Name="TxtRateHz" Text="Rate: 0.0 Hz" FontSize="11" Foreground="#34D399" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock x:Name="TxtRttMs" Text="RTT: 0.0 ms" FontSize="11" Foreground="#FBBF24" FontFamily="Consolas"/>
                    </Border>
                    <Border Background="#1E293B" CornerRadius="4" Padding="8,4" Margin="4,0">
                        <TextBlock x:Name="TxtMcuClock" Text="CLK: 0" FontSize="11" Foreground="#94A3B8" FontFamily="Consolas"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Filter & Controls Toolbar -->
        <Border Grid.Row="1" Background="#161F30" BorderBrush="#1F2937" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Mode Radio Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Filter:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
                    <RadioButton x:Name="RdoAll" Content="All Packets" IsChecked="True" Checked="Filter_Changed" Foreground="#E2E8F0" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RdoRx" Content="Inbound [RX]" Checked="Filter_Changed" Foreground="#38BDF8" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RdoTx" Content="Outbound [TX]" Checked="Filter_Changed" Foreground="#C084FC" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RdoAck" Content="ACKs &amp; Responses" Checked="Filter_Changed" Foreground="#34D399" Margin="0,0,14,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Search Input -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#64748B" FontSize="11"/>
                    <TextBox x:Name="TxtSearch" Width="200" TextChanged="TxtSearch_TextChanged"/>
                </StackPanel>

                <!-- Action Controls -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkAutoScroll" Content="Auto-Scroll" IsChecked="True" Margin="0,0,12,0"/>
                    <Button x:Name="BtnPauseResume" Content="PAUSE" Width="80" Click="BtnPauseResume_Click" Margin="0,0,6,0"/>
                    <Button Content="COPY" Width="70" Click="BtnCopy_Click" Margin="0,0,6,0"/>
                    <Button Content="CLEAR" Width="70" Click="BtnClear_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Real-Time Packet Stream Virtualized Feed -->
        <Border Grid.Row="2" Background="#0A0E17" Padding="8">
            <ListBox x:Name="LstPackets"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     ScrollViewer.CanContentScroll="True"
                     VirtualizingStackPanel.IsVirtualizing="True"
                     VirtualizingStackPanel.VirtualizationMode="Recycling"
                     FontFamily="Consolas"
                     FontSize="12">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding BackgroundBrush}"
                                BorderBrush="{Binding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,2"
                                Padding="8,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Timestamp -->
                                <TextBlock Grid.Column="0" Text="{Binding Timestamp}" Foreground="#64748B" Width="95" VerticalAlignment="Top"/>

                                <!-- Direction Badge -->
                                <Border Grid.Column="1" Background="{Binding BadgeBackground}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Direction}" Foreground="{Binding BadgeForeground}" FontWeight="Bold" FontSize="11"/>
                                </Border>

                                <!-- JSON Content -->
                                <TextBlock Grid.Column="2" Text="{Binding JsonText}" Foreground="{Binding ContentForeground}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 4. Footer Hardware Diagnostics Strip -->
        <Border Grid.Row="3" Background="#111827" BorderBrush="#1F2937" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1: Live Hardware Endstops Indicators -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ENDSTOPS (LIVE):" FontWeight="Bold" FontSize="11" Foreground="#00E5FF" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        
                        <!-- J1 Endstop -->
                        <Border x:Name="BorderEndstopJ1" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ1" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ1" Text="J1 (X-MIN/PE5)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- J2 Endstop -->
                        <Border x:Name="BorderEndstopJ2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ2" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ2" Text="J2 (X-MAX/PE4)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- J3 Endstop -->
                        <Border x:Name="BorderEndstopJ3" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ3" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ3" Text="J3 (Y-MIN/PJ1)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- J4 Endstop -->
                        <Border x:Name="BorderEndstopJ4" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ4" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ4" Text="J4 (Y-MAX/PJ0)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- J5 Endstop -->
                        <Border x:Name="BorderEndstopJ5" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ5" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ5" Text="J5 (Z-MIN/PD3)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>

                        <!-- J6 Endstop -->
                        <Border x:Name="BorderEndstopJ6" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="3,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="LedEndstopJ6" Width="8" Height="8" Fill="#64748B" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtEndstopJ6" Text="J6 (Z-MAX/PD2)" FontSize="10" FontWeight="SemiBold" Foreground="#E2E8F0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Raw Endstops Mask Summary -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="MASK:" FontWeight="Bold" FontSize="11" Foreground="#64748B" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtEndstops" Text="[0 0 0 0 0 0]" FontSize="11" Foreground="#F59E0B" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Invert Masks, Reset Defaults Button, and Live Joint Coordinates -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Hardware Invert Masks -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="POLARITY:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="2,0">
                            <TextBlock x:Name="TxtDirInvert" Text="DIR: 0x03" FontSize="11" Foreground="#C084FC" FontFamily="Consolas"/>
                        </Border>
                        <Border Background="#1E293B" CornerRadius="3" Padding="6,2" Margin="2,0">
                            <TextBlock x:Name="TxtEndstopInvert" Text="STOP: 0x00" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas"/>
                        </Border>
                        <Button x:Name="BtnRestoreDefaults" Content="RESTORE HARDWARE DEFAULTS" Margin="8,0,0,0" Padding="8,2" FontSize="10" Background="#334155" Foreground="#00E5FF" BorderBrush="#00E5FF" Click="BtnRestoreDefaults_Click"/>
                    </StackPanel>

                    <!-- Live Joint Angles Feed -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="JOINTS:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtLiveJoints" Text="J1: 0.0°  J2: 0.0°  J3: 0.0°  J4: 0.0°  J5: 0.0°  J6: 0.0°" FontSize="11" Foreground="#34D399" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- MCU Step Buffer Slots -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="BUFFERS:" FontWeight="Bold" FontSize="11" Foreground="#94A3B8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtSlotSummary" Text="[16, 16, 16, 16, 16, 16]" FontSize="11" Foreground="#38BDF8" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
