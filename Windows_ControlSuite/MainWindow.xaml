                                        <RadioButton GroupName="CartIkMode" Content="📐 Mode 2: Steady Tool (Lock Rotational Attitude)" IsChecked="{Binding IsIkLockOrientation, Mode=TwoWay}" Foreground="{StaticResource AccentCyan}" FontWeight="Bold" Margin="0,0,0,6" ToolTip="Locks the tool rotational orientation in space and keeps it steady even in between trajectory waypoints."/>
