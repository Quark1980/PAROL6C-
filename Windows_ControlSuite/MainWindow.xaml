<Window x:Class="PAROLC_ControlSuite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:helix="http://helix-toolkit.org/wpf"
        mc:Ignorable="d"
        Title="PAROL6 Control Suite &amp; 6-Axis Real-Time Motion Pipeline"
        Height="920" Width="1480"
        MinHeight="750" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="#141418"
        Foreground="#ECEFF1">

    <Window.Resources>
        <!-- Dark Cyberpunk / Industrial Robotics Palette -->
        <SolidColorBrush x:Key="BgDark" Color="#141418"/>
        <SolidColorBrush x:Key="PanelBg" Color="#1C1D24"/>
        <SolidColorBrush x:Key="CardBg" Color="#252630"/>
        <SolidColorBrush x:Key="BorderDark" Color="#323340"/>
        <SolidColorBrush x:Key="TextLight" Color="#F0F3F6"/>
        <SolidColorBrush x:Key="TextMuted" Color="#8C939E"/>
        <SolidColorBrush x:Key="AccentCyan" Color="#00D2FF"/>
        <SolidColorBrush x:Key="AccentGreen" Color="#00E676"/>
        <SolidColorBrush x:Key="AccentOrange" Color="#FF9100"/>
        <SolidColorBrush x:Key="DangerRed" Color="#FF1744"/>

        <!-- Pulsing Red Animation for Emergency Stop Alert -->
        <Storyboard x:Key="EstopPulseAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="EstopPulsingOverlay"
                             Storyboard.TargetProperty="Opacity"
                             From="0.05" To="0.45" Duration="0:0:0.6" AutoReverse="True"/>
            <DoubleAnimation Storyboard.TargetName="EstopPulseBorder"
                             Storyboard.TargetProperty="Opacity"
                             From="0.2" To="1.0" Duration="0:0:0.6" AutoReverse="True"/>
        </Storyboard>

        <!-- Control Styles -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#2D2F3C"/>
            <Setter Property="Foreground" Value="#F0F3F6"/>
            <Setter Property="BorderBrush" Value="#3D4052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#3D4154"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#252733"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#252630"/>
            <Setter Property="Foreground" Value="#00D2FF"/>
            <Setter Property="BorderBrush" Value="#3D4052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontFamily" Value="Consolas, monospace"/>
        </Style>

        <Style TargetType="TabItem">
            <Setter Property="Background" Value="#1C1D24"/>
            <Setter Property="Foreground" Value="#8C939E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" Margin="0,0,4,0" CornerRadius="4,4,0,0">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="tabBorder" Property="Background" Value="#252630"/>
                                <Setter Property="Foreground" Value="#00D2FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Status Bar -->
            <RowDefinition Height="Auto"/> <!-- Optional Warning Banner -->
            <RowDefinition Height="*"/>    <!-- Main Viewport & Controls -->
        </Grid.RowDefinitions>

        <!-- TOP APP BAR -->
        <Border Grid.Row="0" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Logo / Title -->
                    <ColumnDefinition Width="Auto"/> <!-- Connection Controls -->
                    <ColumnDefinition Width="*"/>    <!-- Telemetry Badges -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Action Buttons -->
                </Grid.ColumnDefinitions>

                <!-- Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="PAROL6" FontWeight="Black" FontSize="18" Foreground="{StaticResource AccentCyan}" VerticalAlignment="Center"/>
                    <TextBlock Text=" 6-AXIS CORE" FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextLight}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Border Background="#252630" CornerRadius="3" Padding="4,2" Margin="8,0,0,0">
                        <TextBlock Text="v2.5 KLIPPER TRAPQ" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                    </Border>
                </StackPanel>

                <!-- Connection Box -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="PI HOST:" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" FontSize="11" FontWeight="Bold" Margin="0,0,6,0"/>
                    <TextBox x:Name="TxtHostAddress" Text="{Binding PiAddress, Mode=TwoWay}" Width="150" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Button x:Name="BtnConnect" Content="{Binding ConnectButtonText}" Click="BtnConnect_Click" Width="95" Height="28">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Background" Value="#00796B"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Background" Value="#C2185B"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Telemetry & Diagnostic Badges -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Klipper Core Status Badge -->
                    <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#37474F"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KlipperReady}" Value="True">
                                        <Setter Property="Background" Value="#1B5E20"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsEstopActive}" Value="True">
                                        <Setter Property="Background" Value="#B71C1C"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#FF5252"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KlipperReady}" Value="True">
                                                <Setter Property="Fill" Value="#69F0AE"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEstopActive}" Value="True">
                                                <Setter Property="Fill" Value="#FF1744"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding KlipperStatus}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                        </StackPanel>
                    </Border>

                    <!-- Robot Engine State Badge -->
                    <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,0" Background="#263238">
                        <TextBlock Text="{Binding RobotState, StringFormat='STATE: {0}'}" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                    </Border>

                    <!-- Homing Badge -->
                    <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#4A148C"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHomed}" Value="True">
                                        <Setter Property="Background" Value="#006064"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding IsHomed, StringFormat='HOMED: {0}'}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFF"/>
                    </Border>

                    <!-- Latency (TCP & UDP) -->
                    <Border Background="#252630" CornerRadius="4" Padding="6,4" Margin="0,0,6,0" ToolTip="TCP Control RTT">
                        <TextBlock Text="{Binding LatencyMs, StringFormat='TCP: {0:F1}ms'}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentCyan}"/>
                    </Border>

                    <Border Background="#252630" CornerRadius="4" Padding="6,4" Margin="0,0,6,0" ToolTip="UDP Motion Streaming RTT">
                        <TextBlock Text="{Binding UdpRttText}" FontSize="11" FontFamily="Consolas" Foreground="#00E5FF"/>
                    </Border>

                    <Border Background="#252630" CornerRadius="4" Padding="6,4" Margin="0,0,6,0" ToolTip="UDP Jitter Variation">
                        <TextBlock Text="{Binding UdpJitterText}" FontSize="11" FontFamily="Consolas" Foreground="#FFD600"/>
                    </Border>

                    <!-- Update Rate -->
                    <Border Background="#252630" CornerRadius="4" Padding="6,4" Margin="0,0,6,0">
                        <TextBlock Text="{Binding UpdateRateHz, StringFormat='RATE: {0:F0}Hz'}" FontSize="11" FontFamily="Consolas" Foreground="{StaticResource AccentGreen}"/>
                    </Border>
                </StackPanel>

                <!-- Quick Actions -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnDebugStream" Content="DEBUG STREAM" Click="BtnDebugStream_Click" Background="#4A148C" Margin="0,0,6,0" ToolTip="Open live data stream &amp; packet monitor"/>
                    <Button Content="SYNC TARGET" Click="BtnSyncGhost_Click" Background="#37474F" Margin="0,0,6,0" ToolTip="Sync target digital twin to active physical robot angles"/>
                    <Button Content="CAD HOME" Click="BtnCadHome_Click" Background="#00838F" ToolTip="Move all joints to CAD home reference pose"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- OPTIONAL BRANCH JUMP / SAFETY WARNING BANNER -->
        <Border Grid.Row="1" Background="#B71C1C" BorderBrush="#FF5252" BorderThickness="0,0,0,1" Padding="12,6">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasWarning}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="⚠️ SAFETY GUARD ACTIVE: " FontWeight="Black" FontSize="12" Foreground="#FFFFFF"/>
                <TextBlock Text="{Binding BranchJumpWarning}" FontSize="12" Foreground="#FFEBEE" FontWeight="Bold"/>
            </StackPanel>
        </Border>

        <!-- MAIN WORKSPACE CONTENT -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>     <!-- 3D Viewport Column -->
                <ColumnDefinition Width="420"/>   <!-- Right Control Dock -->
            </Grid.ColumnDefinitions>

            <!-- 3D VIEWPORT CONTAINER -->
            <Grid Grid.Column="0">
                <!-- HelixToolkit 3D Viewport -->
                <helix:HelixViewport3D x:Name="Viewport3D" 
                                       ZoomExtentsWhenLoaded="False" 
                                       ShowCoordinateSystem="True" 
                                       CoordinateSystemLabelX="X" 
                                       CoordinateSystemLabelY="Y" 
                                       CoordinateSystemLabelZ="Z"
                                       ShowViewCube="True"
                                       IsMoveEnabled="True"
                                       IsRotationEnabled="True"
                                       IsZoomEnabled="True"
                                       Background="#0D0E12"
                                       PreviewMouseDown="Viewport3D_PreviewMouseDown"
                                       PreviewMouseMove="Viewport3D_PreviewMouseMove"
                                       PreviewMouseUp="Viewport3D_PreviewMouseUp">

                    <!-- Default Lighting -->
                    <helix:DefaultLights/>

                    <!-- Ground Grid in Millimeters -->
                    <helix:GridLinesVisual3D Width="1000" Length="1000" MajorDistance="100" MinorDistance="20" Thickness="0.5" Fill="#20222B"/>
                </helix:HelixViewport3D>

                <!-- Floating 3D Overlays -->
                <StackPanel VerticalAlignment="Top" HorizontalAlignment="Left" Margin="16">
                    <Border Background="#CC141418" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="INTERACTIVE 3D DIGITAL TWIN" FontWeight="Bold" FontSize="12" Foreground="{StaticResource AccentCyan}"/>
                            <TextBlock Text="• Drag 3D Gizmo at TCP to move Cartesian target" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
                            <TextBlock Text="• Left Click + Drag: Orbit Camera | Right Click: Pan" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="• Solid Mesh: Interactive Target Twin (CAD)" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <TextBlock Text="• Cyan Ghost: Physical Telemetry Feedback" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                            <CheckBox x:Name="ChkShowGhost" Content="Display Physical Feedback Ghost" IsChecked="True" Checked="ChkShowGhost_Changed" Unchecked="ChkShowGhost_Changed" Foreground="{StaticResource TextLight}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Floating Quick IK Tool Attitude Overlay -->
                    <Border Background="#CC141418" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                        <StackPanel>
                            <TextBlock Text="IK &amp; TOOL ORIENTATION MODE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentOrange}" Margin="0,0,0,4"/>
                            <RadioButton GroupName="OverlayIkMode" Content="🎯 Probe Tip (Free Tool Angle)" IsChecked="{Binding IsIkPositionOnly, Mode=TwoWay}" Foreground="{StaticResource TextLight}" Margin="0,2"/>
                            <RadioButton GroupName="OverlayIkMode" Content="📐 Steady Tool (Lock Tool Angle)" IsChecked="{Binding IsIkLockOrientation, Mode=TwoWay}" Foreground="{StaticResource AccentCyan}" FontWeight="SemiBold" Margin="0,2"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="⬇️ VERTICAL" Click="BtnToolVertical_Click" Padding="6,3" FontSize="10" Margin="0,0,4,0" Background="#00695C" ToolTip="Position tool vertically downward (-Z) and lock steady for drawing/picking"/>
                                <Button Content="➡️ HORIZONTAL" Click="BtnToolHorizontal_Click" Padding="6,3" FontSize="10" Margin="0,0,4,0" Background="#1565C0" ToolTip="Position tool horizontally forward (+X) and lock orientation"/>
                                <Button Content="🔒 LOCK NOW" Click="BtnLockCurrentAngle_Click" Padding="6,3" FontSize="10" Background="#37474F" ToolTip="Lock the tool at its current Roll/Pitch/Yaw attitude"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Floating End-Effector & Animated Gripper Selector Overlay -->
                    <Border Background="#CC141418" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,8" Width="310">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="END EFFECTOR &amp; ANIMATED GRIPPER" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                                <TextBlock Text="{Binding ToolLengthMm, StringFormat='TCP: {0:F0} mm'}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                            </Grid>
                            <ComboBox ItemsSource="{Binding AvailableEndEffectors}" SelectedItem="{Binding SelectedEndEffector, Mode=TwoWay}" Background="#1E2028" Foreground="#111111" FontSize="11" Padding="6,4" Margin="0,0,0,6"/>
                            <Grid Margin="0,0,0,2">
                                <TextBlock Text="Animated Jaw Pose:" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Text="{Binding GripperAngle, StringFormat='{}{0:F0}°'}" HorizontalAlignment="Right" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                            </Grid>
                            <Slider Minimum="0" Maximum="180" Value="{Binding GripperAngle, Mode=TwoWay}" Thumb.DragCompleted="GripperSlider_DragCompleted" Margin="0,0,0,4"/>
                            <CheckBox x:Name="ChkShowCamFov" Content="Show 30° Downward Top Camera Sight Cone" IsChecked="True" Checked="ChkShowCamFov_Changed" Unchecked="ChkShowCamFov_Changed" Foreground="{StaticResource TextLight}" FontSize="10"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Camera Quick Reset Controls -->
                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Orientation="Horizontal" Margin="16">
                    <Button Content="ISOMETRIC" Click="BtnCamIso_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="FRONT" Click="BtnCamFront_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="TOP" Click="BtnCamTop_Click" Margin="0,0,6,0" Padding="8,4" FontSize="10"/>
                    <Button Content="SIDE" Click="BtnCamSide_Click" Padding="8,4" FontSize="10"/>
                </StackPanel>

                <!-- Live TCP Coordinate Overlay (X, Y, Z, Roll, Pitch, Yaw) -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Background="#CC141418" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="55"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="65"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="POSE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentCyan}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="X (mm)" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource DangerRed}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Y (mm)" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentGreen}"/>
                        <TextBlock Grid.Row="0" Grid.Column="3" Text="Z (mm)" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource AccentCyan}"/>
                        <TextBlock Grid.Row="0" Grid.Column="4" Text="Roll°" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Row="0" Grid.Column="5" Text="Pitch°" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Row="0" Grid.Column="6" Text="Yaw°" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{StaticResource TextMuted}"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Actual:" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ActualX, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ActualY, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding ActualZ, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding ActualRoll, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="5" Text="{Binding ActualPitch, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="6" Text="{Binding ActualYaw, StringFormat='{}{0:F1}'}" FontFamily="Consolas" HorizontalAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Target:" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetX, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding TargetY, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding TargetZ, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding TargetRoll, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="5" Text="{Binding TargetPitch, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="6" Text="{Binding TargetYaw, StringFormat='{}{0:F1}'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}" HorizontalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- RIGHT CONTROL & VERIFICATION DOCK -->
            <Border Grid.Column="1" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Emergency Stop Button -->
                        <RowDefinition Height="Auto"/> <!-- E-Stop Recovery Panel -->
                        <RowDefinition Height="Auto"/> <!-- System Actions Bar -->
                        <RowDefinition Height="*"/>    <!-- Tabbed Control Panels -->
                    </Grid.RowDefinitions>

                    <!-- ZERO-LATENCY EMERGENCY STOP BUTTON -->
                    <Border Grid.Row="0" Padding="16,12" Background="#1E1317" BorderBrush="#FF1744" BorderThickness="0,0,0,2">
                        <Button x:Name="BtnEstop" PreviewMouseDown="BtnEstop_PreviewMouseDown" 
                                Height="64" Background="{StaticResource DangerRed}" BorderBrush="#FF5252" BorderThickness="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🚨 EMERGENCY STOP" FontSize="18" FontWeight="Black" Foreground="#FFFFFF" HorizontalAlignment="Center"/>
                                <TextBlock Text="Instant M112 Trapq Flush (SPACEBAR Hotkey)" FontSize="10" FontWeight="SemiBold" Foreground="#FFCDD2" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Button>
                    </Border>

                    <!-- E-STOP RECOVERY PANEL (VISIBLE WHEN ESTOP ACTIVE) -->
                    <Border Grid.Row="1" Background="#2C1217" BorderBrush="#FF1744" BorderThickness="0,0,0,1" Padding="12,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEstopActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <TextBlock Text="EMERGENCY LOCKOUT ACTIVE" FontWeight="Black" FontSize="11" Foreground="#FF5252" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔄 1. CLEAR &amp; RESET MCU" Click="BtnReset_Click" Background="#C62828" Height="32" Margin="0,0,4,0" FontSize="11" FontWeight="Bold"/>
                                <Button Grid.Column="1" Content="🏠 2. HOME ALL" Click="BtnHomeAll_Click" Background="#1565C0" Height="32" Margin="4,0,0,0" FontSize="11" FontWeight="Bold"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- SYSTEM CONTROL BUTTONS & GLOBAL ACTION BAR -->
                    <Grid Grid.Row="2" Margin="16,8,16,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Row="0" Grid.Column="0" Content="⚡ RESET MCU" Click="BtnReset_Click" Background="#2E7D32" Margin="0,0,3,0" Height="34"/>
                        <Button Grid.Row="0" Grid.Column="1" Content="🏠 HOME ALL" Click="BtnHomeAll_Click" Background="#1565C0" Margin="3,0,3,0" Height="34"/>
