                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Save & Refresh Buttons -->
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Content="🔄 REFRESH TRIMS" Click="BtnRefreshTrims_Click" Background="#37474F" Margin="0,0,4,0" Height="36"/>
                                        <Button Grid.Column="1" Content="💾 SAVE TO PI" Click="BtnSaveTrims_Click" Background="#00796B" Margin="4,0,0,0" Height="36"/>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 4: GRIPPER & END EFFECTOR -->
                        <TabItem Header="Gripper">
                            <StackPanel Margin="8">
                                <TextBlock Text="END EFFECTOR MODEL &amp; TOOL OFFSET" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>

                                <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Active End Effector (from Assets/meshes):" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                        <ComboBox ItemsSource="{Binding AvailableEndEffectors}" SelectedItem="{Binding SelectedEndEffector, Mode=TwoWay}" FontSize="11" Padding="6,5" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,4">
                                            <TextBlock Text="Tool Length Offset (-Z from L6 Flange):" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding ToolLengthMm, StringFormat='{}{0:F1} mm'}" HorizontalAlignment="Right" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="220" Value="{Binding ToolLengthMm, Mode=TwoWay}" SmallChange="1" LargeChange="5" Margin="0,0,0,6"/>
                                        <TextBlock Text="Default: 118.0 mm for End_effector_TD-8820MG.stl (with animated sliding fingers &amp; 30° downward top camera)." FontSize="10" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="RC SERVO GRIPPER ACTUATION" FontWeight="Bold" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,8"/>

                                <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <TextBlock Text="Jaw Opening / Servo Angle:" Foreground="{StaticResource TextMuted}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding GripperAngle, StringFormat='{}{0:F0}°  |  '}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                                <TextBlock Text="{Binding GripperMm, StringFormat='{}{0:F1} mm'}" FontFamily="Consolas" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                            </StackPanel>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="180" Value="{Binding GripperAngle, Mode=TwoWay}" Thumb.DragCompleted="GripperSlider_DragCompleted" Margin="0,0,0,12"/>
                                        <UniformGrid Columns="3">
                                            <Button Content="CLOSE (0°)" Click="BtnGripperClose_Click" Margin="2" Height="32"/>
                                            <Button Content="MID (90°)" Click="BtnGripperMid_Click" Margin="2" Height="32"/>
                                            <Button Content="OPEN (180°)" Click="BtnGripperOpen_Click" Margin="2" Height="32"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </TabItem>

                        <!-- TAB: SPEED & SAFETY LIMITS -->
                        <TabItem Header="Speed Limits">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="10">
                                    <TextBlock Text="HARDWARE SPEED &amp; SAFETY LIMITS" FontWeight="Bold" FontSize="13" Foreground="{StaticResource AccentCyan}" Margin="0,0,0,4"/>
                                    <TextBlock Text="Adjust per-joint speed limits to match 6-axis trapq motion boundaries." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

                                    <!-- Master Speed Scale -->
                                    <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="MASTER SPEED SCALING" FontWeight="Bold" Foreground="{StaticResource AccentOrange}"/>
                                                <TextBlock Text="{Binding SpeedScale, StringFormat='{}{0:P0}'}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentOrange}"/>
                                            </Grid>
                                            <Slider Minimum="0.1" Maximum="1.0" Value="{Binding SpeedScale, Mode=TwoWay}" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Staged Move Duration -->
                                    <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="STAGED MOVE DURATION (DISCRETE)" FontWeight="Bold" Foreground="{StaticResource AccentGreen}"/>
                                                <TextBlock Text="{Binding MoveDuration, StringFormat='{}{0:F1} s'}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentGreen}"/>
                                            </Grid>
                                            <Slider Minimum="0.2" Maximum="5.0" Value="{Binding MoveDuration, Mode=TwoWay}" SmallChange="0.1" LargeChange="0.5"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Trajectory Smoothing & Waypoint Blending Time Constant -->
                                    <Border Background="{StaticResource CardBg}" CornerRadius="6" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <TextBlock Text="TRAJECTORY SMOOTHING &amp; BLENDING" FontWeight="Bold" Foreground="{StaticResource AccentCyan}"/>
                                                <TextBlock Text="{Binding SmoothingTimeConstant, StringFormat='{}{0:F2} s'}" FontFamily="Consolas" FontWeight="Bold" HorizontalAlignment="Right" Foreground="{StaticResource AccentCyan}"/>
                                            </Grid>
                                            <Slider Minimum="0.05" Maximum="0.35" Value="{Binding SmoothingTimeConstant, Mode=TwoWay}" SmallChange="0.01" LargeChange="0.05"/>
                                            <TextBlock Text="Controls client-side 50 Hz second-order velocity &amp; acceleration blending to eliminate Follow stutter." FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- J1..J6 Individual Limits -->
                                    <TextBlock Text="PER-JOINT MAXIMUM SPEED (DEG/S)" FontWeight="Bold" FontSize="11" Foreground="{StaticResource TextLight}" Margin="0,4,0,8"/>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J1 Base Limit" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding SpeedLimitJ1, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ1, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J2 Shoulder Limit" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="5" Maximum="60" Value="{Binding SpeedLimitJ2, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ2, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J3 Elbow Limit" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="5" Maximum="60" Value="{Binding SpeedLimitJ3, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ3, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J4 Forearm Limit" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="10" Maximum="80" Value="{Binding SpeedLimitJ4, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ4, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J5 Wrist Pitch" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="10" Maximum="80" Value="{Binding SpeedLimitJ5, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ5, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="{StaticResource CardBg}" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="55"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="J6 Wrist Roll" FontWeight="Bold" VerticalAlignment="Center"/>
                                            <Slider Grid.Column="1" Minimum="10" Maximum="120" Value="{Binding SpeedLimitJ6, Mode=TwoWay}" VerticalAlignment="Center" Margin="8,0"/>
                                            <TextBlock Grid.Column="2" Text="{Binding SpeedLimitJ6, StringFormat='{}{0:F0}°/s'}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <!-- TAB 5: DUAL-LINK RX/TX DIAGNOSTICS & LOGS -->
                        <TabItem Header="📡 RX/TX Logs">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/> <!-- Active MCU Error Banner -->
                                    <RowDefinition Height="Auto"/> <!-- Action Toolbar -->
                                    <RowDefinition Height="Auto"/> <!-- Suite <-> RPi Header -->
                                    <RowDefinition Height="*"/>    <!-- Suite <-> RPi Feed -->
                                    <RowDefinition Height="Auto"/> <!-- RPi <-> MCU Header -->
                                    <RowDefinition Height="*"/>    <!-- RPi <-> MCU Feed -->
                                    <RowDefinition Height="Auto"/> <!-- Local App Log Header -->
                                    <RowDefinition Height="95"/>   <!-- Local App Log Feed -->
                                </Grid.RowDefinitions>

                                <!-- Active Klipper / MCU Error Banner -->
                                <Border Grid.Row="0" Background="#450A0A" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMcuError}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding LastMcuError}" Foreground="#FCA5A5" FontWeight="Bold" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"/>
                                </Border>

                                <!-- Top Toolbar -->
                                <Grid Grid.Row="1" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="📡 OPEN FULL PACKET STREAM WINDOW" Click="BtnDebugStream_Click" Background="#1E293B" Margin="0,0,6,0" Padding="8,4" FontSize="10" FontWeight="Bold"/>
                                    <Button Grid.Column="1" Content="🗑️ CLEAR ALL" Click="BtnClearLog_Click" Background="#7F1D1D" Padding="8,4" FontSize="10" FontWeight="Bold"/>
                                </Grid>

                                <!-- Channel 1: Suite <-> RPi Daemon -->
                                <TextBlock Grid.Row="2" Text="💻 SUITE / TOUCH ↔ RPI DAEMON (WS :8765 / UDP :8766)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentCyan}" Margin="0,2,0,3"/>
                                <TextBox Grid.Row="3" Text="{Binding SuiteRpiLogFeed, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Background="#0D0F14" Foreground="#38BDF8" BorderBrush="{StaticResource BorderDark}" Padding="6" Margin="0,0,0,6"/>

                                <!-- Channel 2: RPi Daemon <-> Klipper / MCU -->
                                <TextBlock Grid.Row="4" Text="🔌 RPI DAEMON ↔ KLIPPER / MCU (klippy.serial @ 250k)" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentGreen}" Margin="0,2,0,3"/>
                                <TextBox Grid.Row="5" Text="{Binding RpiMcuLogFeed, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Background="#0D0F14" Foreground="#34D399" BorderBrush="{StaticResource BorderDark}" Padding="6" Margin="0,0,0,6"/>

                                <!-- Channel 3: Client Kinematics & System Log -->
                                <TextBlock Grid.Row="6" Text="📋 CLIENT KINEMATICS &amp; SYSTEM EVENTS" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentOrange}" Margin="0,2,0,3"/>
                                <TextBox Grid.Row="7" Text="{Binding LogFeed, Mode=OneWay}" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10.5" Background="#141418" BorderBrush="{StaticResource BorderDark}" Padding="6"/>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Grid>
            </Border>
        </Grid>

        <!-- FULL-SCREEN PULSING RED OVERLAY FOR EMERGENCY STOP VISIBILITY -->
        <Border x:Name="EstopPulsingOverlay"
                Grid.Row="0" Grid.RowSpan="3"
                Background="#B71C1C"
                Opacity="0.0"
                IsHitTestVisible="False"/>

        <Border x:Name="EstopPulseBorder"
                Grid.Row="0" Grid.RowSpan="3"
                BorderBrush="#FF1744"
                BorderThickness="6"
                Opacity="0.0"
                IsHitTestVisible="False"/>
    </Grid>
</Window>
